在数组中找到m个连续数的和的最小值是多少。（此代码中涉及了mmin=0x3f3f3f3f;这个东西表示最小值是无穷大的意思，0x3f3f3f3f表示无穷大在竞赛中常用，可以多留意。）
输入样例              输出样例    
8 3                  6 
1
4
7
3
1
2
4
3
#include <bits/stdc++.h>
using namespace std;
int main()
{
 int n,m;
    cin>>n>>m;
    int a[100005];
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }
    int mmin=0x3f3f3f3f;
    for(int i=0;i<=n-m;i++)
    {
        int A=0;
        for(int j=i;j<i+m;j++)
        {
            A+=a[j];
        }
        if(A<mmin)
        {mmin=A;}
    }
    cout<<mmin<<endl;
    return 0;
}
