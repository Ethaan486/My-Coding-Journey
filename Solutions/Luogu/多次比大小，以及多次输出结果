先输入一个n，表示有n个数。后用循环结构输入多个数组；再先定义一个A来记录总数，因为要连续输出，所以把A套在循环结构里。再用一个循环结构进行多次比较，最后连续输出，最后结束。
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n,a[105];
    cin>>n;
    for(int i=0;i<n;i++)
    {
       cin>>a[i]; 
    }
    for(int i=0;i<n;i++)
    {
        int A=0;
        for(int j=0;j<i;j++)
        {
            if(a[j]<a[i])
            {A++;}
        }
        cout<<A<<" ";
    }
    return 0;
}
