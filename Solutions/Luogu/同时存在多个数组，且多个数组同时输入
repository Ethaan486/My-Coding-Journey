同时存在多个数组，且多个数组同时输入
输入样例         输出样例
3               2
90 90 90
85 95 90
80 100 91
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cin>>n;
    int c[1005];
    int m[1005];
    int e[1005];
    int z[1005];
    for(int i=0;i<n;i++)
    {
        cin>>c[i]>>m[i]>>e[i];
        z[i]=c[i]+m[i]+e[i];
    }
    int A=0;
    for(int i=0;i<n;i++)
    {
        for(int j=i+1;j<n;j++)
        {
            int d_c=abs(c[i]-c[j]);
            int d_m=abs(m[i]-m[j]);
            int d_e=abs(e[i]-e[j]);
            int d_z=abs(z[i]-z[j]);
            if(d_c<=5&&d_m<=5&&d_e<=5&&d_z<=10)
            {
                A++;
            }    
        }
    }
    cout<<A<<endl;
    return 0;
}
