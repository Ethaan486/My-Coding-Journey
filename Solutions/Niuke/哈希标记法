哈希标记法
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int N;
    cin>>N;
    int A[1005];
    int a[5005]={0};
    for(int i=0;i<N;i++)
    {
        cin>>A[i];
    }
    for(int i=0;i<N;i++)
    {
        if(a[A[i]]==0)
        {
            cout<<A[i]<<" ";
           a[A[i]]=1;
        }
    }
    return 0;
}
