杨辉三角
第一次认识到用数组表示矩阵
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cin>>n;
    long long a[40][40];
    for(int i=0;i<n;i++)
    {
        a[i][0]=1;
        a[i][i]=1;
        for(int j=1;j<i;j++)
        {
            a[i][j]=a[i-1][j]+a[i-1][j-1];
        }
    }
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<=i;j++)
        {
            cout<<a[i][j];
            if(j<i)
            {
                cout<<" ";
            }
        }
        cout<<endl;
    }
    return 0;
}
