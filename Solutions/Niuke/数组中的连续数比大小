数组中的连续数比大小
且设定到了一定数就重新计数
输入样例                  输出样例
5                         UP
3 4 5 6 7
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n,a[105];
    cin>>n;
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }
    if(n==1)
    {
        if(a[0]==0)
        {cout<<"UP"<<endl;}
        else if(a[0]==15)
        {cout<<"DOWN"<<endl;}
        else
            cout<<"-1"<<endl;
    }
    else 
    {
        if(a[n-1]==0)
        {cout<<"UP"<<endl;}
        else if(a[n-1]==15)
        {cout<<"DOWN"<<endl;}
        else if(a[n-1]>a[n-2])
        {cout<<"UP"<<endl;}
        else if(a[n-1]<a[n-2])
        {cout<<"DOWN"<<endl;}
        else
            cout<<"-1"<<endl;
    }
    return 0;
}
